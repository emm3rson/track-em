{
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.8.12",
    "@react-navigation/native": "^7.1.25",
    "@react-navigation/native-stack": "^7.10.1",
    "expo": "^57.0.19",
    "expo-build-properties": "~57.0.16",
    "expo-constants": "~57.0.17",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "jest-expo": "~57.0.5",
    "lucide-react-native": "^0.575.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "^19.2.0",
    "sharp": "^0.34.5",
    "typescript": "~6.0.3"
  },
  "name": "finance-tracker",
  "version": "4.0.0",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform android",
    "ota:preview": "eas update --channel preview --platform android --environment preview",
    "ota:prod": "eas update --channel production --platform android --environment production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --runInBand",
    "typecheck": "tsc --noEmit",
    "logos:sync": "node --experimental-strip-types scripts/syncInstitutionLogos.ts",
    "logos:check": "node --experimental-strip-types scripts/syncInstitutionLogos.ts --check",
    "logos:download": "node --experimental-strip-types scripts/downloadInstitutionLogos.ts",
    "verify:logos": "npm run logos:check && node --experimental-strip-types scripts/verifyInstitutionLogos.ts",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"App.tsx\" \"index.ts\" \"README.md\" \"releases/**/*.md\" \".eslintrc.cjs\" \".prettierrc\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"App.tsx\" \"index.ts\" \"README.md\" \"releases/**/*.md\" \".eslintrc.cjs\" \".prettierrc\"",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:ci",
    "audit:ui-layering": "powershell -ExecutionPolicy Bypass -File scripts/audit-ui-layering.ps1",
    "audit:tokens": "node scripts/auditColorLiterals.js",
    "audit:frontend": "npm run audit:tokens && npm run lint && npm run typecheck"
  }
}
